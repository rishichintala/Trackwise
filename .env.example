# Copy this file to .env and fill in your values
# Only VITE_ prefixed variables are exposed to the browser build

# URL of your backend API (no trailing slash)
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api
# Production example (Render, Railway, etc.):
# VITE_API_BASE_URL=https://your-api.yourdomain.com/api

# Backend (also set in Netlify environment variables for production)
DATABASE_URL="your-postgresql-url"
JWT_SECRET="your-32-char-secret"

# Resend email (password reset)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Trackwise <noreply@adminsvctemple.space>"
# Production frontend URL used in reset email links
FRONTEND_URL="https://trackyourbudgetwise.netlify.app"

# Gemini API (server-side only — used for AI spending insights)
GEMINI_API_KEY="your-gemini-api-key"
