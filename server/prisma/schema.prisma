generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  currency            String               @default("USD")
  createdAt           DateTime             @default(now())
  expenses            Expense[]
  budgets             Budget[]
  incomes             Income[]
  passwordResetTokens PasswordResetToken[]
  apiKeys             ApiKey[]
  aiUsage             AiUsage[]
}

model ApiKey {
  id         String    @id @default(uuid())
  keyHash    String    @unique
  label      String    @default("Splito")
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Expense {
  id        String   @id @default(uuid())
  amount    Float
  itemName  String
  category  String
  date      DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Budget {
  id       String @id @default(uuid())
  amount   Float
  category String
  month    String // YYYY-MM
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, category, month])
}

model Income {
  id     String @id @default(uuid())
  amount Float
  month  String // YYYY-MM
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, month])
}

// Per-user daily counters for Gemini-backed endpoints, to bound worst-case
// API cost since the app runs on stateless serverless functions (no
// in-memory rate limiter survives between invocations).
model AiUsage {
  id            String @id @default(uuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD (UTC)
  insightsCount Int    @default(0)
  chatCount     Int    @default(0)

  @@unique([userId, date])
}
